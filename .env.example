# MongoDB Atlas connection string (from cloud.mongodb.com)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/vidyamotion?retryWrites=true&w=majority
MONGODB_URI=

# Optional database name override (defaults to vidyamotion)
MONGODB_DB=vidyamotion

# JWT Secret for authenticating sessions (any long random string)
JWT_SECRET=vidyamotion_super_secure_secret_key_change_in_production_32chars!

# AI Provider API Keys
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
